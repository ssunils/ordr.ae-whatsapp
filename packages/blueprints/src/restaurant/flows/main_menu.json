{
  "id": "main_menu",
  "description": "Entry point shown on first contact and on 'menu'.",
  "entry": "welcome",
  "nodes": [
    {
      "id": "welcome",
      "type": "question",
      "var": "menu_choice",
      "prompt": {
        "en": "Welcome to {{tenant.name}}! How can we help you today?",
        "ar": "أهلاً بك في {{tenant.name}}! كيف يمكننا مساعدتك اليوم؟"
      },
      "input": {
        "kind": "buttons",
        "options": [
          { "id": "order_food", "title": { "en": "Order food", "ar": "اطلب طعام" }, "next": "go_order" },
          { "id": "track_order", "title": { "en": "Track my order", "ar": "تتبع طلبي" }, "next": "go_track" },
          { "id": "talk_to_us", "title": { "en": "Talk to us", "ar": "تحدث معنا" }, "next": "go_talk" }
        ]
      },
      "invalidText": {
        "en": "Please tap one of the buttons, or type 1, 2 or 3.",
        "ar": "يرجى الضغط على أحد الأزرار، أو كتابة 1 أو 2 أو 3."
      },
      "maxRetries": 2
    },
    { "id": "go_order", "type": "goto_flow", "flow": "order_food" },
    { "id": "go_track", "type": "goto_flow", "flow": "track_order" },
    { "id": "go_talk", "type": "goto_flow", "flow": "talk_to_us" }
  ]
}
